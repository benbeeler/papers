\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  {\bf  Charge-density difference, $\Delta \rho $, around surface oxygen in UN. (\textbf  {a}) $\mathrm  {O}_{\mathrm  {N}}^{\text  {(s)}}$ in the $a$-$b$ plane. (\textbf  {b}) $\mathrm  {O}_{\mathrm  {N}}^{\text  {(s)}}$ in the $a$-$c$ plane. (\textbf  {c}) $\mathrm  {O}_i^{\text  {(s)}}$ in the plane spanned by the nearest O-U direction and the crystallographic $c$ axis, with $c$ vertical. Red denotes electron accumulation and blue denotes electron depletion in $\Delta \rho $. Solid and dashed contours mark positive and negative $\Delta \rho $, respectively. U, N, and O atoms are shown as purple, green, and yellow markers. }\relax }}{15}{figure.caption.10}\protected@file@percent }
