\@writefile{lot}{\contentsline {table}{\numberline {C.8}{\ignorespaces {\bf  Verification of the monotonicity condition for the unsaturated $\mathrm  {O_N}^{(\mathrm  {s})}$ contribution to $|\Delta \sigma |$. The effective transport activation energy, $E_m+E_f(v_\text  {N}^{(\text  {b})})+E_b$, is much larger than $2E_\text  {seg}$ for all stoichiometric limits, so the kinetic factor increases with temperature faster than the segregation factor decreases below the saturation temperature. The positive values in the last row show that the condition $\genfrac  {}{}{}1{1}{2}(E_m+E_f+E_b)>E_\text  {seg}$ is comfortably satisfied.}\relax }}{35}{table.caption.20}\protected@file@percent }
\newlabel{Tab:App:monotonicity}{{C.8}{35}{\DIFaddFL {Verification of the monotonicity condition for the unsaturated $\mathrm {O_N}^{(\mathrm {s})}$ contribution to $|\Delta \sigma |$. The effective transport activation energy, $E_m+E_f(v_\text {N}^{(\text {b})})+E_b$, is much larger than $2E_\text {seg}$ for all stoichiometric limits, so the kinetic factor increases with temperature faster than the segregation factor decreases below the saturation temperature. The positive values in the last row show that the condition $\tfrac {1}{2}(E_m+E_f+E_b)>E_\text {seg}$ is comfortably satisfied.}\relax }{table.caption.20}{}}
\newlabel{Tab:App:monotonicity@cref}{{[table][8][2147483647]C.8}{[1][35][]35}}
