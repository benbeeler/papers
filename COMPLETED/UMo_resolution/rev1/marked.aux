\citation{hasan2024gb}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces  \textbf  {Comparison of the re-solution rates in UO$_2$, UC, and U-10Mo.} The re-solution rates in various nuclear materials are shown as a function of bubble radius $R_b$. For UO$_2$, the re-solution rate is dominated by the heterogeneous mechanism, which is driven by the thermal spikes resulting from the electronic stopping of FFs. In contrast, for UC and U-10Mo, re-solution is primarily governed by the homogeneous mechanism (nuclear stopping) since their higher electronic conductivities suppress thermal spike formation. The piecewise re-solution model for U-10Mo employed in the DART code is also included for comparison. \relax }}{22}{figure.caption.15}\protected@file@percent }
\newlabel{fig:comp}{{15}{22}{\textbf {Comparison of the re-solution rates in UO$_2$, UC, and U-10Mo.} The re-solution rates in various nuclear materials are shown as a function of bubble radius $R_b$. For UO$_2$, the re-solution rate is dominated by the heterogeneous mechanism, which is driven by the thermal spikes resulting from the electronic stopping of FFs. In contrast, for UC and U-10Mo, re-solution is primarily governed by the homogeneous mechanism (nuclear stopping) since their higher electronic conductivities suppress thermal spike formation. The piecewise re-solution model for U-10Mo employed in the DART code is also included for comparison. \relax }{figure.caption.15}{}}
