\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  \textbf  {Equilibrium Xe number density as a function of bubble radius.} The equilibrium Xe number density \DIFaddbeginFL  {\bf  at $400$ K }\DIFaddendFL  within the gas bubbles was calculated using the van der Waals EOS. The equilibrium bubble pressure used in the EOS was derived from the Young-Laplace equation, utilizing a surface energy of $\gamma = 1.55$ J/m$^2$. \relax }}{13}{figure.caption.6}\protected@file@percent }
\newlabel{fig:vdw}{{6}{13}{\textbf {Equilibrium Xe number density as a function of bubble radius.} The equilibrium Xe number density \DIFaddbeginFL \DIFaddFL {at $400$ K }\DIFaddendFL within the gas bubbles was calculated using the van der Waals EOS. The equilibrium bubble pressure used in the EOS was derived from the Young-Laplace equation, utilizing a surface energy of $\gamma = 1.55$ J/m$^2$. \relax }{figure.caption.6}{}}
