\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces  \textbf  {Fraction of Xe atoms re-solved from gas bubbles ($\chi $) as a function of FF energy ($E$) and off-center distance ($\ell $).} The bubble is centered at the origin $(x, w) = (0, 0)$, and the FF is initiated at $(x, w) = (-(R_b + \delta ), \ell )$ with an energy $E$ and a direction along the $x$ axis. $R_b$ is the bubble radius and $\delta $ is the maximum recoil distance. \textbf  {a, b} $\chi (E, \ell )$ for a bubble with a $2$ nm radius interacting with incident (\textbf  {a}) \ce {_{39}^{97}Y}\xspace  and (\textbf  {b}) \ce {_{53}^{136}I}\xspace  . \textbf  {c, d} $\chi (E, \ell )$ for a bubble with a $64$ nm radius interacting with incident (\textbf  {c}) \ce {_{39}^{97}Y}\xspace  and (\textbf  {d}) \ce {_{53}^{136}I}\xspace  . Error bars represent $2 \sigma $ \DIFdelbeginFL  \DIFdelendFL  \DIFaddbeginFL  {\bf  deviation }\DIFaddendFL  from the mean across $5,000$ independent BCA simulations per configuration. \relax }}{17}{figure.caption.10}\protected@file@percent }
\newlabel{fig:chi}{{10}{17}{\textbf {Fraction of Xe atoms re-solved from gas bubbles ($\chi $) as a function of FF energy ($E$) and off-center distance ($\ell $).} The bubble is centered at the origin $(x, w) = (0, 0)$, and the FF is initiated at $(x, w) = (-(R_b + \delta ), \ell )$ with an energy $E$ and a direction along the $x$ axis. $R_b$ is the bubble radius and $\delta $ is the maximum recoil distance. \textbf {a, b} $\chi (E, \ell )$ for a bubble with a $2$ nm radius interacting with incident (\textbf {a}) \Y and (\textbf {b}) \I . \textbf {c, d} $\chi (E, \ell )$ for a bubble with a $64$ nm radius interacting with incident (\textbf {c}) \Y and (\textbf {d}) \I . Error bars represent $2 \sigma $ \DIFdelbeginFL \DIFdelFL {deviations }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {deviation }\DIFaddendFL from the mean across $5,000$ independent BCA simulations per configuration. \relax }{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces  \textbf  {Illustration of the $\xi $ calculation scheme.} $\xi (x, w)$ denotes the re-solved bubble fraction for a bubble centered at $(x, w)$ interacting with a FF originating at $(0, 0)$ with an initial velocity along the $x$ axis. A square surface $S$ with side length $2D$ is constructed at a distance $D = R_b + \delta $ distance from the bubble center, where \DIFaddbeginFL  {\bf  $\delta $ represents }\DIFaddendFL  the \DIFaddbeginFL  {\bf  distance beyond which the probability of finding a recoil capable of interacting with the bubble is negligible. The }\DIFaddendFL  surface normal is oriented at an angle $\alpha (x, w)$--the average FF incidence angle--relative to the $x$ axis. The surface is discretized into small mesh elements\DIFaddbeginFL  {\bf  , where an individual element $m$ has an area $A_m$}\DIFaddendFL  . The FF may reach a mesh element $m$ with a probability per unit area $p_m$ and energy $E$, resulting in a re-solved fraction $\chi (E, \ell )$. Here, $\ell $ is the distance between the \DIFaddbeginFL  {\bf  mesh }\DIFaddendFL  element center $r_m$ and the surface center $r_c$. The total re-solved fraction $\xi $ is obtained by summing the contributions from all possible trajectories through the mesh elements. \relax }}{18}{figure.caption.11}\protected@file@percent }
\newlabel{fig:surf_mesh}{{11}{18}{\textbf {Illustration of the $\xi $ calculation scheme.} $\xi (x, w)$ denotes the re-solved bubble fraction for a bubble centered at $(x, w)$ interacting with a FF originating at $(0, 0)$ with an initial velocity along the $x$ axis. A square surface $S$ with side length $2D$ is constructed at a distance $D = R_b + \delta $ distance from the bubble center, where \DIFaddbeginFL \DIFaddFL {$\delta $ represents }\DIFaddendFL the \DIFaddbeginFL \DIFaddFL {distance beyond which the probability of finding a recoil capable of interacting with the bubble is negligible. The }\DIFaddendFL surface normal is oriented at an angle $\alpha (x, w)$--the average FF incidence angle--relative to the $x$ axis. The surface is discretized into small mesh elements\DIFaddbeginFL \DIFaddFL {, where an individual element $m$ has an area $A_m$}\DIFaddendFL . The FF may reach a mesh element $m$ with a probability per unit area $p_m$ and energy $E$, resulting in a re-solved fraction $\chi (E, \ell )$. Here, $\ell $ is the distance between the \DIFaddbeginFL \DIFaddFL {mesh }\DIFaddendFL element center $r_m$ and the surface center $r_c$. The total re-solved fraction $\xi $ is obtained by summing the contributions from all possible trajectories through the mesh elements. \relax }{figure.caption.11}{}}
\newlabel{eq:xitob}{{15}{18}{Calculation of \texorpdfstring {$\xi $}{xi}}{equation.3.15}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.3.5}Homogeneous re-solution rate}{18}{subsubsection.3.3.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces  \textbf  {Spatial distribution of $\xi $ and $\xi \Delta V$ for \ce {_{39}^{97}Y}\xspace  FFs.} The re-solved bubble fraction $\xi $ and volume-weighted re-solved bubble fraction $\xi \Delta V$ are shown for a gas bubble centered at $(0, 0)$ and a \ce {_{39}^{97}Y}\xspace  FF at $(x, w)$ pointing toward the $-x$ direction. Note that this spatial arrangement is equivalent to the one in Figure \ref  {fig:coord} but represents the inverse of the setup shown in Figure \ref  {fig:surf_mesh}. \textbf  {a, b} $\xi $ and $\xi \Delta V$ for a bubble radius of $2$ nm. \textbf  {c, d} $\xi $ and $\xi \Delta V$ for a bubble radius of $64$ nm. \relax }}{19}{figure.caption.12}\protected@file@percent }
\newlabel{fig:xi}{{12}{19}{\textbf {Spatial distribution of $\xi $ and $\xi \Delta V$ for \Y FFs.} The re-solved bubble fraction $\xi $ and volume-weighted re-solved bubble fraction $\xi \Delta V$ are shown for a gas bubble centered at $(0, 0)$ and a \Y FF at $(x, w)$ pointing toward the $-x$ direction. Note that this spatial arrangement is equivalent to the one in Figure \ref {fig:coord} but represents the inverse of the setup shown in Figure \ref {fig:surf_mesh}. \textbf {a, b} $\xi $ and $\xi \Delta V$ for a bubble radius of $2$ nm. \textbf {c, d} $\xi $ and $\xi \Delta V$ for a bubble radius of $64$ nm. \relax }{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.3.6}Effect of bubble pressure}{19}{subsubsection.3.3.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces  \textbf  {Homogeneous re-solution rate as a function of bubble radius $R_b$ in U-10Mo}. The re-solution rate was calculated at the equilibrium Xe number density $n_{eq}$ for bubble radii ranging from $2$ nm to $64$ nm. The solid line represents a power-law fit of the form $aR_b^k + c$, which describes the data with high precision ($R^2 = 0.99986$). Error bars denote $2 \sigma $ \DIFdelbeginFL  \DIFdelendFL  \DIFaddbeginFL  {\bf  deviation }\DIFaddendFL  from the mean, reflecting the uncertainty in $\chi $. \relax }}{20}{figure.caption.13}\protected@file@percent }
\newlabel{fig:res}{{13}{20}{\textbf {Homogeneous re-solution rate as a function of bubble radius $R_b$ in U-10Mo}. The re-solution rate was calculated at the equilibrium Xe number density $n_{eq}$ for bubble radii ranging from $2$ nm to $64$ nm. The solid line represents a power-law fit of the form $aR_b^k + c$, which describes the data with high precision ($R^2 = 0.99986$). Error bars denote $2 \sigma $ \DIFdelbeginFL \DIFdelFL {deviations }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {deviation }\DIFaddendFL from the mean, reflecting the uncertainty in $\chi $. \relax }{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces  \textbf  {Effect of Xe number density ($n$) on re-solved bubble fraction ($\chi $).} BCA simulations of FF interactions with under- and over-pressurized bubbles reveal an inverse relationship between $\chi $ and $n$. The lines represent the fit $\chi / \chi _{eq} = n_{eq} / n$, which accurately describes the data ($R^2 = 0.97$). This relationship arises because the number of re-solved Xe atoms remains nearly invariant regardless of the bubble's Xe number density. Data were obtained from $5,000$ independent BCA simulations per configuration. \relax }}{20}{figure.caption.14}\protected@file@percent }
\newlabel{fig:pres}{{14}{20}{\textbf {Effect of Xe number density ($n$) on re-solved bubble fraction ($\chi $).} BCA simulations of FF interactions with under- and over-pressurized bubbles reveal an inverse relationship between $\chi $ and $n$. The lines represent the fit $\chi / \chi _{eq} = n_{eq} / n$, which accurately describes the data ($R^2 = 0.97$). This relationship arises because the number of re-solved Xe atoms remains nearly invariant regardless of the bubble's Xe number density. Data were obtained from $5,000$ independent BCA simulations per configuration. \relax }{figure.caption.14}{}}
