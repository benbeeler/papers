\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  \textbf  {Temporal evolution of a thermal spike simulation in U-10Mo.} Snapshots of a $30$ keV/nm thermal spike simulation at (\textbf  {a}) $0$ ps, (\textbf  {b}) $2.4$ ps, (\textbf  {c}) $10.1$ ps, and (\textbf  {d}) $29.1$ ps. Xe gas atoms are represented in black, U in red, and Mo in blue. The local ionic temperature rises rapidly for $1.5$ ps before beginning to cool. No Xe atom was observed to escape the gas bubble. The images were rendered using OVITO. \relax }}{8}{figure.caption.2}\protected@file@percent }
\newlabel{fig:ttm}{{2}{8}{\textbf {Temporal evolution of a thermal spike simulation in U-10Mo.} Snapshots of a $30$ keV/nm thermal spike simulation at (\textbf {a}) $0$ ps, (\textbf {b}) $2.4$ ps, (\textbf {c}) $10.1$ ps, and (\textbf {d}) $29.1$ ps. Xe gas atoms are represented in black, U in red, and Mo in blue. The local ionic temperature rises rapidly for $1.5$ ps before beginning to cool. No Xe atom was observed to escape the gas bubble. The images were rendered using OVITO. \relax }{figure.caption.2}{}}
